{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloudflare": {
    "TurnKeyId": "",
    "ApiToken": "",
    "TtlSeconds": 3600,
    "Enabled": true,
    "FallbackIceServers": [
      {
        "urls": [ "stun:stun.cloudflare.com:3478" ]
      }
    ]
  },
  "Go2Rtc": {
    "BaseUrl": "http://localhost:1984",
    "DefaultStream": "octocamrtc",
    "TimeoutSeconds": 10
  },
  "SnapshotCache": {
    "DefaultTtlSeconds": 5
  }
}

